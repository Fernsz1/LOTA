[connection signal="pressed" from="Panel/VBox/ControlsButton" to="." method="_on_controls_pressed"]
[connection signal="pressed" from="Panel/VBox/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Panel/VBox/EndMatchButton" to="." method="_on_end_match_pressed"]
