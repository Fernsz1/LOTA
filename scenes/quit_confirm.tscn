[connection signal="value_changed" from="Panel/VBox/MusicVolumeRow/MusicVolumeSlider" to="." method="_on_music_volume_changed"]
[connection signal="value_changed" from="Panel/VBox/SFXVolumeRow/SFXVolumeSlider" to="." method="_on_sfx_volume_changed"]
[connection signal="toggled" from="Panel/VBox/FullscreenRow/FullscreenCheck" to="." method="_on_fullscreen_toggled"]
